  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
